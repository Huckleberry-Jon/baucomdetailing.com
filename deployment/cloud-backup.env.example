# Set privately in the approved hosted runner. No values belong in Git.
ALLOW_EXTERNAL_BACKUP_UPLOAD=false
BACKUP_APPROVAL_REF=
BACKUP_PASSPHRASE=
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
# Preferred production source: tenant-scoped read-only Worker endpoint.
BACKUP_SOURCE_URL=https://baucomdetailing.com/api/recovery/snapshot
BACKUP_SOURCE_TOKEN=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=
RECOVERY_ENDPOINT=
RECOVERY_REGION=
RECOVERY_BUCKET=
RECOVERY_ACCESS_KEY_ID=
RECOVERY_SECRET_ACCESS_KEY=
SOURCE_NAMESPACE=production

# Separate bucket-only reader for downloaded-backup verification (supply both).
RECOVERY_READ_ACCESS_KEY_ID=
RECOVERY_READ_SECRET_ACCESS_KEY=

# Required for restore-local: exact-version receipt retained outside B2.
RECOVERY_VERSION_RECEIPT=

# Approved production immutable bucket only.
RECOVERY_IMMUTABLE_DAYS=30
BACKUP_HEALTH_TOKEN=
