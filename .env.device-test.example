APP_ENV=device-test
DEV_ORIGIN=http://localhost:4324
DEV_SECRETS_FILE=data/device-test/secrets.json
DEV_VAPID_SUBJECT=
DEV_ALLOW_PUSH_SEND=false
DEV_ALLOW_EMAIL_SEND=false
DEV_TEST_EMAIL_RECIPIENTS=
DEV_RESEND_API_KEY=
DEV_EMAIL_FROM=
DEV_OWNER_NOTIFICATION_EMAIL=
